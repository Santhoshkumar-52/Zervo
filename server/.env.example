# Server
NODE_ENV=development
PORT=5000

# Database
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gym_management
DB_USER=root
DB_PASSWORD=

prod_DB_CLIENT=
prod_DB_HOST=
prod_DB_PORT=
prod_DB_NAME=
prod_DB_USER=
prod_DB_PASSWORD=
# Roles
Granted_Roles=[1,2]  # 1=owner, 2=manager, 3=front_desk, 4=trainer
# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# JWT expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
CLIENT_URL=http://localhost:5173

# AI API key
GEMINI_API_KEY=